# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files (generated by preprocessing script)
/data/*.db
/data/*.json

# generated sitemaps (scripts/generate-sitemaps.mjs) — ~41 files, rebuilt from
# the databases, so they are published by regenerating rather than committing
/data/sitemaps/
/data/sitemaps.tmp/

# database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# large files (>2MB)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.parquet
*.csv
*.tsv

# jupyter notebooks (may contain large outputs)
*.ipynb

# temp files
.tmp/
*.tmp
*.temp
*.bak
*.swp
*~

# editor directories
.idea/
.vscode/
*.sublime-*

# memory/cache files
memory

# external data directories
DOAJ_journals_list/
scopus_journals_list/
scripts/__pycache__/

# runtime logs (a single server log reached 1.76 GB)
/logs/
/server.log

# Bulk inputs and vendored binaries, purged from history 2026-10-14 (they had
# grown .git to 353 MB). Keep them out of the repo; copies live outside it.
# scripts/import_journal_enrichment.py and import_scopus_only_journals.py take
# the Scopus workbook as a --path argument, so restore it locally to run them.
journals_data/*.xlsx
*.duckdb
*.deb
