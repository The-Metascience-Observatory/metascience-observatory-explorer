# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files (generated by preprocessing script)
/data/*.db
/data/*.json

# database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# large files (>2MB)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.parquet
*.csv
*.tsv

# jupyter notebooks (may contain large outputs)
*.ipynb

# temp files
.tmp/
*.tmp
*.temp
*.bak
*.swp
*~

# editor directories
.idea/
.vscode/
*.sublime-*

# memory/cache files
memory

# external data directories
DOAJ_journals_list/
scopus_journals_list/
scripts/__pycache__/
